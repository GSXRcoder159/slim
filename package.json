{
  "name": "slim",
  "version": "0.1.0",
  "description": "Delete your dependencies. Replace a used slice with a verified, dependency-free implementation.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "slim": "./dist/main.js"
  },
  "exports": {
    ".": "./dist/main.js",
    "./vitest": "./dist/trace/vitest.js",
    "./hooks": "./dist/trace/hook.js"
  },
  "files": [
    "dist",
    "action",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test --test-reporter=spec test/*.test.ts test/*/*.test.ts",
    "slim": "node --experimental-strip-types src/main.ts"
  },
  "keywords": [
    "dependencies",
    "bundle",
    "lodash",
    "serverless",
    "edge"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/slim-hq/slim"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.3.0",
    "clsx": "^2.1.1",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "moment": "^2.30.1",
    "ms": "^2.1.3",
    "nanoid": "^5.1.5",
    "typescript": "^5.9.2",
    "uuid": "^11.1.0"
  }
}
