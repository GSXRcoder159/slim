{
  "name": "slim",
  "version": "0.1.0",
  "description": "Delete your dependencies. Replace a used slice with a verified, dependency-free implementation.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "slim": "dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./vitest": {
      "types": "./dist/trace/vitest.d.ts",
      "default": "./dist/trace/vitest.js"
    },
    "./hooks": {
      "types": "./dist/trace/hook.d.ts",
      "default": "./dist/trace/hook.js"
    }
  },
  "types": "./dist/main.d.ts",
  "main": "./dist/main.js",
  "files": [
    "dist",
    "action",
    "slim.schema.json",
    "docs/*.schema.json",
    "docs/support-inventory.json",
    "docs/README.md",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "node --experimental-strip-types --test --test-reporter=spec test/*.test.ts test/*/*.test.ts",
    "similarity": "node --experimental-strip-types scripts/similarity-gate.ts",
    "typecheck": "node ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "artifacts": "node --experimental-strip-types scripts/artifact-identity.ts",
    "qualify": "node --experimental-strip-types scripts/qualify-receipts.ts",
    "qualify:emit": "node --experimental-strip-types scripts/emit-local-receipts.ts",
    "qualify:candidate": "node --experimental-strip-types scripts/qualify-candidate.ts",
    "release:gate": "node --experimental-strip-types scripts/release-gate.ts",
    "slim": "node --experimental-strip-types src/main.ts",
    "refresh:golden": "node --experimental-strip-types scripts/refresh-golden-fixture.ts",
    "measure:claims": "node --experimental-strip-types scripts/measure-claims.ts"
  },
  "keywords": [
    "dependencies",
    "bundle",
    "lodash",
    "serverless",
    "edge"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GSXRcoder159/slim.git"
  },
  "bugs": {
    "url": "https://github.com/GSXRcoder159/slim/issues"
  },
  "homepage": "https://github.com/GSXRcoder159/slim#readme",
  "dependencies": {},
  "devDependencies": {
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.3.0",
    "bluebird": "3.7.2",
    "clsx": "2.1.1",
    "lodash": "4.17.21",
    "lodash-es": "4.17.21",
    "mime-types": "2.1.35",
    "moment": "2.30.1",
    "ms": "2.1.3",
    "nanoid": "5.1.5",
    "typescript": "^5.9.2",
    "uuid": "11.1.0",
    "whatwg-url": "14.2.0"
  }
}
