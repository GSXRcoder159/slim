{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/slim/docs/upstream.schema.json",
  "title": "Slim upstream --json report",
  "description": "One JSON document on stdout for success and non-success. schemaVersion 1. Unconsulted sources use status success with detail 'not required' and are ignored when folding fail-closed. Consulted OSV/npm statuses are success, unavailable, timeout, malformed, and stale. Missing OSV vulns is malformed, not a successful empty advisory set.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ok", "exit", "status", "conclusion", "action", "sources", "findings", "regeneration"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "ok": { "type": "boolean" },
    "exit": { "type": "integer", "enum": [0, 1, 2, 3, 4] },
    "status": { "type": "string", "enum": ["ok", "fail", "usage", "refused", "env"] },
    "conclusion": {
      "type": "string",
      "enum": [
        "exposed",
        "not-exposed",
        "unmapped",
        "routine-release",
        "source-unavailable",
        "oracle-unavailable",
        "incomplete-state",
        "missing-state",
        "malformed-state",
        "regeneration-failure",
        "no-replacements"
      ]
    },
    "action": { "type": "string", "enum": ["none", "blocked", "review", "regenerated"] },
    "error": { "type": "string" },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["osv", "npm", "oracle", "github"],
      "properties": {
        "osv": { "$ref": "#/$defs/source" },
        "npm": { "$ref": "#/$defs/source" },
        "oracle": { "$ref": "#/$defs/source" },
        "github": { "$ref": "#/$defs/source" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "package",
          "pinned",
          "latest",
          "id",
          "exposure",
          "affectedRange",
          "usedSymbols",
          "mappedEvidence",
          "upstreamChange",
          "unmappedReason"
        ],
        "properties": {
          "package": { "type": "string" },
          "pinned": { "type": "string" },
          "latest": { "type": "string" },
          "id": { "type": "string" },
          "summary": { "type": ["string", "null"] },
          "details": { "type": ["string", "null"] },
          "exposure": { "type": "string", "enum": ["exposed", "unmapped", "not-exposed"] },
          "affectedRange": { "type": "string" },
          "usedSymbols": { "type": "array", "items": { "type": "string" } },
          "mappedEvidence": { "type": "string" },
          "upstreamChange": { "type": "string" },
          "unmappedReason": { "type": ["string", "null"] }
        }
      }
    },
    "regeneration": {
      "type": "array",
      "items": { "$ref": "#/$defs/regen" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "detail"],
      "properties": {
        "status": { "type": "string", "enum": ["success", "unavailable", "timeout", "malformed", "stale"] },
        "detail": { "type": "string" }
      }
    },
    "regen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "regenerated", "usedCatalog", "fuzzed", "oracleKind", "oracleVersion", "residualRisk"],
      "properties": {
        "package": { "type": "string" },
        "regenerated": { "type": "boolean" },
        "usedCatalog": { "type": "boolean" },
        "fuzzed": { "type": "boolean" },
        "oracleKind": { "type": ["string", "null"], "enum": ["new", "old", null] },
        "oracleVersion": { "type": ["string", "null"] },
        "residualRisk": { "type": "array", "items": { "type": "string" } },
        "fuzz": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cases", "comparisons", "timerCases"],
          "properties": {
            "cases": { "type": "integer", "minimum": 0 },
            "comparisons": { "type": "integer", "minimum": 0 },
            "timerCases": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
