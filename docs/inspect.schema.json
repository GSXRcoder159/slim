{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/@gsxrcoder159/slim/docs/inspect.schema.json",
  "title": "Slim inspect --json report",
  "description": "One JSON document on stdout for try and refuse. Usage errors use docs/error.schema.json. schemaVersion 1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "envelope", "hash", "decision", "reason"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "envelope": { "$ref": "envelope.schema.json" },
    "hash": { "type": "string", "minLength": 64, "maxLength": 64 },
    "decision": { "type": "string", "enum": ["try", "refuse"] },
    "reason": { "type": "string" }
  }
}
